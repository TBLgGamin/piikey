<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX manifest of piikey, for the Microsoft Store. packaging/windows/package-msix.ps1 copies it
  next to the release folder and fills the {{...}} values; makeappx packs it. Why each capability,
  excluded key and excluded folder is here: CERTIFICATION.md (same folder).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop desktop6 virtualization rescap">

  <Identity
    Name="{{IdentityName}}"
    Publisher="{{Publisher}}"
    Version="{{Version}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>piikey</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>

    <!-- piikey changes things outside its package on purpose: the Windows proxy, the sign-in
         clean-up, the local CA, the Explorer menu and its data folder, which piikey-cli shares.
         Windows 11 leaves exactly those unvirtualized (the two lists below) and keeps virtualizing
         the rest. Windows 10 has no such lists: it uses the two desktop6 lines instead, which
         switch virtualization of HKCU and AppData off altogether. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <virtualization:RegistryWriteVirtualization>
      <virtualization:ExcludedKeys>
        <!-- The system proxy (app/src/sysproxy.rs). -->
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Internet Settings</virtualization:ExcludedKey>
        <!-- The entry that gives the proxy back at the next sign-in (app/src/sysproxy.rs). -->
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\RunOnce</virtualization:ExcludedKey>
        <!-- The local CA in the user's Root store (app/src/ca.rs, certutil -user). -->
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Microsoft\SystemCertificates\Root</virtualization:ExcludedKey>
        <!-- The Explorer verb "Scan for PII" (app/src/shell.rs). -->
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Classes\*\shell\piikey.scan</virtualization:ExcludedKey>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Classes\Directory\shell\piikey.scan</virtualization:ExcludedKey>
        <virtualization:ExcludedKey>HKEY_CURRENT_USER\Software\Classes\Directory\Background\shell\piikey.scan</virtualization:ExcludedKey>
      </virtualization:ExcludedKeys>
    </virtualization:RegistryWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <!-- The vault, settings, CA, model and inventory (src/sys.rs data_dir): piikey-cli.exe
             from the zip or the installer uses the same folder, and it outlives the package. -->
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\piikey</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <!-- 1903 is the first Windows with unvirtualizedResources. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.26100.0" />
    <!-- The C++ runtime that ONNX Runtime and Rust's std need (the 14.40 release): the Store
         installs this framework. -->
    <PackageDependency
      Name="Microsoft.VCLibs.140.00.UWPDesktop"
      MinVersion="14.0.33728.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- The app: tray icon, window, local proxy. Runs as the user, not in an app container. -->
    <Application Id="Piikey" Executable="piikey.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="piikey"
        Description="Finds, flags and masks personal data in what you type, send and store. Everything runs on your PC."
        BackgroundColor="#6f49b1"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- piikey.exe on the PATH, and what Explorer's menu and the sign-in clean-up start
             (app/src/sysproxy.rs, shell.rs): the folder of the package changes with every version. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="piikey.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="piikey.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
        <!-- "Start piikey when I sign in" (app/src/startup.rs). Off until the user switches it on in
             piikey (Settings > General) or under Settings > Apps > Startup. Windows starts the exe
             without arguments; startup.rs reads the activation kind to start in the tray. -->
        <desktop:Extension Category="windows.startupTask" Executable="piikey.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="piikeyStartup" Enabled="false" DisplayName="piikey" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <!-- The command line: piikey-cli.exe on the PATH, no entry in the Start menu. -->
    <Application Id="PiikeyCli" Executable="piikey-cli.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="piikey command line"
        Description="The command line of piikey: scans, masks and restores text and files."
        BackgroundColor="#6f49b1"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="piikey-cli.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="piikey-cli.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A full-trust desktop app (Win32, WinUI 3) in a package. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Lets the package declare the unvirtualized keys and folder above. -->
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
